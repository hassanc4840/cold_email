# ============================================
# Nexariza AI Outreach System - Configuration Template
# Copy this to .env and fill in your values
# ============================================

# Gemini API Keys (https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Groq API Keys (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# SMTP Configuration (Default outreach sender)
SMTP_SERVER=smtp.zoho.com
SMTP_PORT=465
SENDER_EMAIL=contact@yourdomain.com
SENDER_PASSWORD=your_smtp_password

# Company Description (used by AI to craft pitches)
NEXARIZA_DESCRIPTION=Nexariza is a workflow automation and AI solutions company that helps businesses reduce manual processes, improve efficiency, and scale operations using smart automation pipelines, AI agents, and custom software integrations.

# Sales SMTP Configuration (Optional secondary sender)
SALES_SMTP_SERVER=smtp.zoho.com
SALES_SMTP_PORT=465
SALES_SENDER_EMAIL=sales@yourdomain.com
SALES_SENDER_PASSWORD=your_sales_password
